{
  "tasks": {
    "install": "deno task install:client & deno task install:server",
    "install:client": "cd app/client && yarn install --immutable",
    "install:server": "cd app/server && deno install",

    "start": "deno task start:client & deno task start:server",
    "start:client": "cd app/client && yarn start",
    "start:server": "cd app/server && deno task start",

    "start:build:linux": "cd ./build && ./server_linux",
    "start:build:mac": "cd ./build && ./server_darwin_aarch64",

    "build": "deno run -A ./build.ts",

    "check-translations": "deno run --allow-read ./scripts/checkTranslations.ts"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/cli/parse-args": "jsr:@std/cli/parse-args",

    "@xtool/dayjs": "jsr:@xtool/dayjs@0.1.4",

    "@shared/": "../shared/src/"
  },
  "nodeModulesDir": "auto"
}
