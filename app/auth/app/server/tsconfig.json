{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2025",
    "esModuleInterop": true,
    "sourceMap": false,
    "noUnusedLocals": true,
    "lib": ["es2025", "DOM", "deno.ns", "deno.unstable"],
    "jsx": "react",
    "paths": { "@shared/*": ["../../../shared/src/*"] },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
