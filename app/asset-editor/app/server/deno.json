{
  "tasks": {
    "start": "deno run -A --watch=./src --unstable-kv mod.ts",
    "start:nowatch": "deno run -A --unstable-kv mod.ts",

    "compile": "deno compile -A --unstable-kv --no-check",

    "compile:windows": "deno task compile --target=x86_64-pc-windows-msvc --output ./build/asset-editor_windows ./mod.ts",
    "compile:linux": "deno task compile --target=x86_64-unknown-linux-gnu --output ./build/asset-editor_linux ./mod.ts",
    "compile:darwin": "deno task compile --target=x86_64-apple-darwin --output ./build/asset-editor_darwin ./mod.ts",

    "build": "(deno task compile:linux) & (deno task compile:darwin) & (deno task compile:windows)"
  },
  "imports": {
    "shared/": "./src/shared/",
    "system/": "./src/system/",
    "modules/": "./src/modules/",

    "@shared/": "../../../shared/src/",

    "@zip-js": "jsr:@zip-js/zip-js@2.25.0",

    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "@std/ulid": "jsr:@std/ulid@1",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",

    "yaml": "npm:yaml@2.9.0",
    "imagescript": "jsr:@matmen/imagescript@3.20.4"
  }
}
