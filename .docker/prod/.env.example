# which projects to run: openhotel, auth, web, onet, static, asset-editor (comma list) or all
COMPOSE_PROFILES=openhotel

# release to install on first start: latest, or a fixed version like 1.0.0 (or 1.0.0-beta.1)
VERSION=latest

# with VERSION=latest: true = newest release including pre-releases, false = newest stable only
PRERELEASE=false

# optional: GitHub token (no scopes needed) to avoid the 60 requests/hour anonymous API limit
GITHUB_TOKEN=

# host ports: a fixed port (9400) or a range (9400-9410) = first free one in the range.
# ranges must not overlap. check the port each service got with: docker compose ps
OPENHOTEL_PORT=1990-1994
AUTH_PORT=2020-2024
WEB_PORT=2025-2029
ONET_PORT=9400-9410
STATIC_PORT=1995-1999
ASSET_EDITOR_PORT=2030-2039
